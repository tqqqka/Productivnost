<?xml version="1.0" encoding="utf-8"?>
<!--
  Служба нужна ради трёх вещей:
  1) окно TYPE_ACCESSIBILITY_OVERLAY лежит выше системной строки состояния и
     шторки Samsung — только так своя шторка может открываться свайпом сверху;
  2) takeScreenshot даёт кадр экрана для размытого фона, как на iPhone;
  3) плитки, которые Android не даёт переключить напрямую (авиарежим,
     мобильные данные, геолокация...), нажимаются в системной панели,
     спрятанной под нашей шторкой.
  Система сама запускает включённую службу после перезагрузки.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/service_description"
    android:notificationTimeout="250"
    android:settingsActivity="com.tihon.shtorka.MainActivity" />
